{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varda-dev.github.io/varda-manifest/manifest.schema.json",
  "title": "Varda Server Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack",
    "version",
    "neoforge",
    "mods"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2,
      "description": "Current Varda server manifest schema version."
    },
    "pack": {
      "type": "string",
      "const": "varda"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "minecraft": {
      "type": "string",
      "minLength": 1
    },
    "neoforge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "installer_url"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "installer_url": {
          "$ref": "#/$defs/httpUrl"
        },
        "sha1": {
          "$ref": "#/$defs/sha1"
        }
      }
    },
    "server_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "$ref": "#/$defs/httpOrFileUrl"
        },
        "sha1": {
          "$ref": "#/$defs/sha1"
        }
      }
    },
    "mods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "sha1"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "$ref": "#/$defs/httpOrFileJarUrl"
          },
          "website_url": {
            "$ref": "#/$defs/httpUrl"
          },
          "sha1": {
            "$ref": "#/$defs/sha1"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "httpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "httpOrFileUrl": {
      "type": "string",
      "pattern": "^(?:https?|file):"
    },
    "httpOrFileJarUrl": {
      "type": "string",
      "pattern": "^(?:https?|file):.*\\.[jJ][aA][rR](?:[?#].*)?$"
    }
  }
}
